import java.util.Arrays;

public class moving_zero_to_end {
    public static void main(String[] args){
        int[] ar={0,0,0,0,0};
        int[] dummy=new int[ar.length];
        int p=0;
        for(int i=0;i< ar.length;i++){
            if(ar[i]!=0){
                dummy[p]=ar[i];
                p++;
            }
        }
        ar=dummy;
        System.arraycopy(dummy,0,ar,0,ar.length);//har ghar mai new value hojayegii ghar change nahi hoga
        System.out.println(Arrays.toString(ar));//aaray ek ghar and dummy dusra ar dusra ghar ko point karne lagta ha
    }
}
