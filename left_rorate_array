import java.util.Arrays;

public class leftrotatearraybyoneplace {
    public static void main(String[] args) {
        int[] ar = {1, 2, 3, 4, 5};
        int temp = ar[0];

        for (int i = 1; i < ar.length; i++) {
            ar[i - 1] = ar[i];
        }

        ar[ar.length - 1] = temp;
            System.out.print(Arrays.toString(ar));
    }
}
